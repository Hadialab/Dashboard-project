# Port the API listens on.
PORT=5000

# Comma-separated list of origins allowed to call the API.
# The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production without this set.
JWT_SECRET=

# How long a session token stays valid, e.g. 30m, 12h, 7d.
JWT_EXPIRES_IN=12h
