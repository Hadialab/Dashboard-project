# Port the API listens on. Ignored on Render, which supplies its own PORT at
# deploy time; 5000 is the local default.
PORT=5000

# Interface to bind. 0.0.0.0 accepts connections from anywhere, which is what a
# deployed service needs. Set 127.0.0.1 only to keep the API unreachable from
# outside the machine — do not do this in production, or a reverse proxy in front of
# it will get 502 for every request.
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the API.
# The Vite dev server runs on 5173 by default. Both localhost and 127.0.0.1 are
# needed: they are different origins to the browser, so whichever one you type
# in the address bar must be listed. Leave unset to get both.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production without this set.
JWT_SECRET=

# How long a session token stays valid, e.g. 30m, 12h, 7d.
JWT_EXPIRES_IN=12h

# Where the browser reaches this app, with no trailing slash.
#
# Password reset emails contain a link built from this. Get it wrong and the
# failure is quiet: the link is still a correctly-signed token, nothing errors,
# and the mail simply goes somewhere that is not this app. The API refuses to
# start in production without it set.
APP_URL=http://localhost:5173

# ===== PostgreSQL (required) =====
# The API refuses to start without this.
#
# This database holds every tenant's data, so the password is a production
# secret. Never commit a filled-in copy of this file — .env is gitignored.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
#
# On Windows, if the password contains characters like @ / : # you must
# percent-encode them, or the URL is parsed as the wrong password.
DATABASE_URL=

# Connections kept open. Raise for a busy install, lower on a small one.
DATABASE_POOL_SIZE=10

# Set to false to stop creating tables on boot and apply schema.sql yourself.
RUN_MIGRATIONS=true

# ===== Email (optional) =====
# With these unset the app still works: the "Email" button on a follow-up
# opens the user's own mail client via a mailto: link instead of sending
# server-side. Set them to send real email.
#
# Password reset needs a working provider. Without one, the request still
# returns the same "if an account exists" answer it always does — but no link
# is sent, and nobody can reset a password.
#
# Every attempt is recorded in the sent_email table, whether it succeeded,
# failed, or was skipped for want of configuration.
#
# Provider currently implemented: resend
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM="CRM Dashboard <crm@yourdomain.com>"
