# Staging. Loaded by `npm run build:staging`, which runs Vite with
# mode=staging. Committed because it contains nothing secret.
#
# REPLACE the placeholder host below before this is deployed. src/config.ts
# refuses to build a staging or production bundle that still points at
# example.com, so a forgotten value fails the build rather than shipping an app
# that cannot reach anything.

VITE_API_URL=https://api-staging.example.com
VITE_API_TIMEOUT=60000
VITE_APP_ENV=staging

# A separate Sentry project from production, so staging noise is never mixed into
# real reports. Leave empty to disable tracking entirely.
VITE_SENTRY_DSN=
