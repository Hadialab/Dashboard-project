{
  "//": [
    "Incremental migration from JavaScript. Nothing here changes how Vite builds",
    "the app: esbuild strips the types, tsc is only used by `npm run typecheck`",
    "and by the editor. That is what makes a file-at-a-time migration safe —",
    "renaming one .js to .ts cannot break the build on its own.",
    "",
    "The two flags below are the migration's progress indicators. When",
    "allowJs/checkJs are off, tsc only looks at the .ts and .tsx files, so the",
    "error count is the debt of the converted part rather than the whole app."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    // Types are stripped, not emitted. Vite handles the actual build.
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // === Migration state ===
    // The migration is finished: no JavaScript is left under src except in
    // `src/test`, which is excluded below. These two flags therefore have nothing
    // left to allow, and `npm run typecheck` covers the whole app.
    "allowJs": false,
    "checkJs": false,

    // === Strictness ===
    // `noImplicitAny` is still off, and is the last step. Turning it on is a real
    // change rather than a formality: it reported 47 errors across files that had
    // already been converted and passed `npm run typecheck`, because an untyped
    // prop is invisible until this flag is on. `npm run typecheck:strict` is that
    // same config, run separately, so the flag can be flipped once the remaining
    // call sites are worth changing.
    //
    // `strictNullChecks` is on. It cost ten fixes, and three of them were crashes
    // rather than type noise: two unguarded `deal.owner.toLowerCase()` calls that
    // threw whenever a list contained an unassigned deal, and a null check missing
    // off the lead-conversion path. None of those had a failing test, because
    // none of them had a test.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,

    // Worth having from the start in any project that will be handed on.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "e2e",
    "src/test",
    "playwright.config.js"
  ]
}
