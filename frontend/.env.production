# Production. Loaded by `npm run build`, which runs Vite with mode=production.
# Committed because it contains nothing secret.
#
# REPLACE the placeholder host below before this is deployed. src/config.ts
# refuses to build a production bundle that still points at example.com, that
# uses http instead of https, or that has no URL at all.

VITE_API_URL=https://api.example.com
VITE_API_TIMEOUT=60000
VITE_APP_ENV=production

# Real production DSN, from https://sentry.io. Empty means no error tracking,
# which is the safe default: better blind than quietly leaking customer records
# to a third party that nobody configured.
VITE_SENTRY_DSN=
