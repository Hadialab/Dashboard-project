# Development. Loaded automatically by `npm run dev`, which runs Vite with
# mode=development. Committed because it contains nothing secret: every VITE_
# value ends up in the bundle and is readable by anyone who opens the app.
#
# To point a machine somewhere else, do NOT edit this file — create
# .env.local, which is gitignored and wins over everything here.

VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=60000
VITE_APP_ENV=development

# Empty means error tracking is off, which is what you want locally: a
# development crash report helps nobody.
VITE_SENTRY_DSN=
