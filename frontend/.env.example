# Development. Copied to .env.local, which Vite loads and git ignores.
#
#   cp .env.example .env.local
#
# Vite loads, in this order of precedence:
#   .env                (shared defaults, committed-safe)
#   .env.local          (your machine, gitignored)
#   .env.development    (loaded when mode=development)
#   .env.production     (loaded when mode=production)
#
# Everything here is VITE_-prefixed, which means it is INLINED INTO THE BUNDLE and
# readable by anyone who opens the app. Never put a secret behind a VITE_ prefix.
# Secrets belong in backend/.env, which never leaves the server.

# The API. Local by default.
VITE_API_URL=http://localhost:5000

# Request timeout in ms. Generous, because a free-tier host can take 30-50s to
# wake from idle.
VITE_API_TIMEOUT=60000

# Named so error reports are attributable. Unset means no error tracking, which
# is the default for development — nothing is sent anywhere.
VITE_APP_ENV=development

# Sentry DSN. Leave empty locally; set it in the deployment environment to turn
# tracking on. Free tier: https://sentry.io
VITE_SENTRY_DSN=
