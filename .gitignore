# Verification scripts written during development. Always deleted, but a
# git add -A after writing one has caught them twice now.
*.tmp.mjs

# Video project. 164 MB across ~7,000 files of source assets, renders and
# exported clips, belonging to a separate tool and not to this application.
# Ignored rather than deleted: it is real work, just not this repository's.
video/

# Playwright's output for a failed run. Screenshots, traces and videos are
# regenerated by re-running the suite, and a stale failure is worth looking at
# once - not carrying in history forever.
test-results/
playwright-report/
blob-report/
.playwright/

# Written by the password-rotation script. Holds a live database credential in
# clear text, so it must never be committed — add the password to your password
# manager and delete the file.
rotated-password.txt
*.password.txt
